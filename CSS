/* ------------------------------
   Styles généraux
------------------------------ */

* {
  box-sizing: border-box;
  color: #6b3f28
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Goergia, sans-serif;
  line-height: 1.6;
  color: #222;
  background: #f7f8fa;
}

/* Les liens utilisent une couleur visible et accessible */
a {
  color: #174ea6;
}

/* ------------------------------
   Navigation
------------------------------ */

.header {
  background: #F3EDE4;
  border-bottom: 1px solid #ddd;
}

.nav {
  max-width: 1100px;
  margin: auto;
  padding: 1rem 1.5rem;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-weight: bold;
  text-decoration: none;
  color: #222;
}

.nav-links {
  display: flex;
  gap: 1.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-links a {
  text-decoration: none;
  font-weight: bold;
}

/* ------------------------------
   Présentation
------------------------------ */

.hero {
  max-width: 1100px;
  margin: auto;
  padding: 5rem 1.5rem;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 3rem;
}

.hero-text {
  max-width: 650px;
}

.intro {
  color: #6b3f28;
  font-weight: bold;
}

h1 {
  font-size: 2.8rem;
  line-height: 1.2;
  color: #6b3f28;
}

h1 span {
  color: #6b3f28;
}

.profile-photo {
  width: 220px;
  height: 220px;
  object-fit: cover;
  border-radius: 50%;
  border: 5px solid white;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

/* Bouton réutilisable */
.button {
  display: inline-block;
  margin-top: 1rem;
  padding: 0.8rem 1.2rem;

  background: #6b3f28;
  color: white;
  text-decoration: none;
  border-radius: 5px;
  font-weight: bold;
}

.button:hover {
  background: ##6b3f28;
}

/* ------------------------------
   Sections
------------------------------ */

.section {
  max-width: 1100px;
  margin: auto;
  padding: 4rem 1.5rem;
}

.section h2,
.contact h2 {
  text-align: center;
  margin-bottom: 2rem;
}

/* Grille flexible pour les cartes */
.cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.card {
  background: #F3EDE4;
  padding: 1.5rem;
  border: 1px solid #ddd;
  border-radius: 8px;
}

.card h3 {
  margin-top: 0;
  color: #6b3f28;
}

/* ------------------------------
   Contact
------------------------------ */

.contact {
  text-align: center;
  background: #eaf0f8;
  padding: 4rem 1.5rem;
}

/* ------------------------------
   Pied de page
------------------------------ */

footer {
  text-align: center;
  padding: 1.5rem;
  background: #222;
  color: white;
}

/* ------------------------------
   Responsive
   Ces règles s'appliquent sur les petits écrans.
------------------------------ */

@media (max-width: 700px) {

  .nav {
    flex-direction: column;
    gap: 1rem;
  }

  .nav-links {
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero {
    flex-direction: column-reverse;
    text-align: center;
    padding-top: 3rem;
  }

  h1 {
    font-size: 2.2rem;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .profile-photo {
    width: 180px;
    height: 180px;
  }
}
